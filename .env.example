# Copy this file to .env and fill in your own values. .env is git-ignored; never commit it.
# Format: KEY=value (no quotes needed). Leave a key empty to switch that feature off.

# --- Mail (read-only IMAP, app passwords only) ---
# Gmail inboxes: address|app password (create at myaccount.google.com/apppasswords). Add GMAIL_2, GMAIL_3 ... for more.
GMAIL_1=you@example.com|abcd efgh ijkl mnop
# Second Gmail inbox (optional)
GMAIL_2=inbox2@example.com|abcd efgh ijkl mnop
# iCloud inboxes: address|app-specific password (account.apple.com). Add ICLOUD_2 ... for more.
ICLOUD_1=inbox3@example.com|abcd-efgh-ijkl-mnop
# Comma-separated inboxes kept out of the Important tab (still used for delivery codes, orders and deadlines)
IMPORTANT_SKIP=inbox2@example.com

# --- Delivery routing (used to tag parcels by the town on the delivery address) ---
# Town of the prep centre that receives stock
PREP_TOWN=Prepton
# Town of your own delivery address
HOME_TOWN=Hometown
# Name printed on parcel labels, used to spot the delivery town in carrier emails (optional)
RECIPIENT_NAME=Jane Doe

# --- Discord webhooks (channels in your own server) ---
# Delivery codes (Amazon/DPD OTPs)
OTP_WEBHOOK_URL=https://discord.example.com/webhook/otp-CHANGE_ME
# Purchases tracker problems (cancelled, missing units, stuck orders)
PURCHASE_WEBHOOK_URL=https://discord.example.com/webhook/purchases-CHANGE_ME
# Urgent alerts (high-priority emails, deadlines within 48h)
URGENT_WEBHOOK_URL=https://discord.example.com/webhook/urgent-CHANGE_ME

# --- Google Sheet + Calendar (Apps Script web app from purchases_sheet_script.gs) ---
# Web app URL from Deploy > New deployment (starts with https://script.google.com/)
SHEET_WEBHOOK_URL=https://apps-script.example.com/exec
# Shared secret; must match TOKEN in purchases_sheet_script.gs
SHEET_WEBHOOK_TOKEN=CHANGE_ME

# --- Google Calendar (read-only secret iCal addresses) ---
# Name|secret iCal address. Add CALENDAR_ICS_2 ... for more calendars.
CALENDAR_ICS_1=Personal|https://calendar.example.com/private-CHANGE_ME/basic.ics

# --- Bank feeds (TrueLayer Open Banking, read-only) ---
# Client ID from the TrueLayer console (an id starting with "sandbox-" uses the sandbox)
TRUELAYER_CLIENT_ID=sandbox-yourapp-CHANGE_ME
# Client secret from the TrueLayer console
TRUELAYER_CLIENT_SECRET=CHANGE_ME
# Your own company's name as it appears on bank statements (transfers from it are categorised as Transfers)
OWN_COMPANY_NAME=Example Trading Ltd

# --- Amazon SP-API (optional alternative sales source, spapi.py) ---
# Login with Amazon app client ID
SP_API_CLIENT_ID=amzn1.application-oa2-client.CHANGE_ME
# Login with Amazon app client secret
SP_API_CLIENT_SECRET=CHANGE_ME
# Refresh token from authorising the app in Seller Central
SP_API_REFRESH_TOKEN=Atzr|CHANGE_ME
# true to deduct output VAT (1/6 of VAT-inclusive sales) from profit
VAT_REGISTERED=true

# --- Job hunt page (companion job-dashboard site) ---
# Base URL of the job dashboard site
JOB_DASHBOARD_URL=https://job-dashboard.example.com/
# API key sent as x-dashboard-key
JOB_DASHBOARD_KEY=CHANGE_ME

# --- Deal monitors + watchdog ---
# Folder of the separate oa-bot deal-monitor project (logs are read, never written)
OA_BOT_DIR=C:\path\to\oa-bot
# Windowless Python used by the watchdog to relaunch services
PYTHONW=C:\Python314\pythonw.exe
